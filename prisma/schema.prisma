generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Customer {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  phoneCountryCode String           @default("+504")
  phone            String?
  notes            String?
  createdAt        DateTime         @default(now())
  orders           Order[]
  account          CustomerCredit[]
}

model Supplier {
  purchases                  Purchase[]
  deliveryContactName        String?
  deliveryContactPhone       String?
  deliveryContactCountryCode String      @default("+504")
  id                         String      @id @default(uuid()) @db.Uuid
  name                       String
  region                     String
  phoneCountryCode           String      @default("+504")
  phone                      String?
  createdAt                  DateTime    @default(now())
  products                   Product[]
  items                      OrderItem[]
}

model Product {
  purchaseItems     PurchaseItem[]
  costEffectiveAt   DateTime?
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  unit              String         @default("lb")
  salePrice         Decimal        @db.Decimal(12, 2)
  estimatedCost     Decimal        @db.Decimal(12, 2)
  defaultSupplierId String         @db.Uuid
  defaultSupplier   Supplier       @relation(fields: [defaultSupplierId], references: [id])
  active            Boolean        @default(true)
  // Approximate days a fresh lot lasts from receipt, and how many days
  // before expiry to warn. Null when it does not apply.
  shelfLifeDays     Int?
  warnDays          Int?
  createdAt         DateTime       @default(now())
  items             OrderItem[]
}

enum RoundStatus {
  OPEN
  CLOSED
}

model Round {
  purchases        Purchase[]
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  status           RoundStatus       @default(OPEN)
  opensAt          DateTime
  closesAt         DateTime
  createdAt        DateTime          @default(now())
  orders           Order[]
  financeMovements FinanceMovement[]
  carriedItems     OrderItem[]       @relation("CarriedItems")
}

model Order {
  // ENCARGO belongs to an open cycle; DIRECT is a walk-in sale from stock,
  // counted in the cycle of the first lot it consumed.
  kind           String           @default("ENCARGO")
  payments       Payment[]
  deliveries     Delivery[]
  id             String           @id @default(uuid()) @db.Uuid
  roundId        String           @db.Uuid
  round          Round            @relation(fields: [roundId], references: [id])
  customerId     String           @db.Uuid
  customer       Customer         @relation(fields: [customerId], references: [id])
  notes          String?
  // PICKUP: the customer collects it. DELIVERY: we take it, charging
  // shippingFee (0 when the delivery is free).
  delivery       String           @default("PICKUP")
  shippingFee    Decimal          @default(0) @db.Decimal(12, 2)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          OrderItem[]
  accountEntries CustomerCredit[]

  @@index([roundId])
  @@index([kind, createdAt])
}

model OrderItem {
  source            String            @default("PREORDER")
  allocations       StockAllocation[]
  deliveryItems     DeliveryItem[]
  totalAmount       Decimal?          @db.Decimal(12, 2)
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @db.Uuid
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String            @db.Uuid
  product           Product           @relation(fields: [productId], references: [id])
  supplierId        String            @db.Uuid
  supplier          Supplier          @relation(fields: [supplierId], references: [id])
  quantity          Decimal           @db.Decimal(12, 3)
  unitPrice         Decimal           @db.Decimal(12, 2)
  estimatedUnitCost Decimal?          @db.Decimal(12, 2)
  // Pending pounds supplied from a later cycle; the sale stays in its own.
  fulfillRoundId    String?           @db.Uuid
  fulfillRound      Round?            @relation("CarriedItems", fields: [fulfillRoundId], references: [id])

  @@index([fulfillRoundId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  before     Json?
  after      Json
  createdAt  DateTime @default(now())

  @@index([entityId, createdAt])
}

model Purchase {
  id         String         @id @default(uuid()) @db.Uuid
  roundId    String         @db.Uuid
  round      Round          @relation(fields: [roundId], references: [id])
  supplierId String         @db.Uuid
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  orderedAt  DateTime
  createdAt  DateTime       @default(now())
  version    Int            @default(1)
  items      PurchaseItem[]
  receipts   Receipt[]
}

model PurchaseItem {
  id             String        @id @default(uuid()) @db.Uuid
  purchaseId     String        @db.Uuid
  purchase       Purchase      @relation(fields: [purchaseId], references: [id])
  productId      String        @db.Uuid
  product        Product       @relation(fields: [productId], references: [id])
  quantity       Decimal       @db.Decimal(12, 3)
  quotedUnitCost Decimal       @db.Decimal(12, 2)
  receiptItems   ReceiptItem[]

  @@unique([purchaseId, productId])
}

model Receipt {
  id             String        @id @db.Uuid
  purchaseId     String        @db.Uuid
  purchase       Purchase      @relation(fields: [purchaseId], references: [id])
  receivedAt     DateTime
  invoice        String
  notes          String?
  globalDiscount Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())
  items          ReceiptItem[]
}

model ReceiptItem {
  allocations       StockAllocation[]
  withdrawals       StockWithdrawal[]
  id                String            @id @default(uuid()) @db.Uuid
  receiptId         String            @db.Uuid
  receipt           Receipt           @relation(fields: [receiptId], references: [id])
  purchaseItemId    String            @db.Uuid
  purchaseItem      PurchaseItem      @relation(fields: [purchaseItemId], references: [id])
  quantity          Decimal           @db.Decimal(12, 3)
  unitCost          Decimal           @db.Decimal(12, 2)
  unitDiscount      Decimal           @db.Decimal(12, 2)
  allocatedDiscount Decimal           @db.Decimal(12, 2)
  netTotal          Decimal           @db.Decimal(14, 2)
  effectiveUnitCost Decimal           @db.Decimal(16, 6)
  // From the product's shelf life, or the date printed on what arrived.
  expiresAt         DateTime?

  @@unique([receiptId, purchaseItemId])
}

model StockAllocation {
  id            String      @id @default(uuid()) @db.Uuid
  receiptItemId String      @db.Uuid
  receiptItem   ReceiptItem @relation(fields: [receiptItemId], references: [id])
  orderItemId   String      @db.Uuid
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity      Decimal     @db.Decimal(12, 3)
  delivered     Decimal     @default(0) @db.Decimal(12, 3)

  @@unique([receiptItemId, orderItemId])
  @@index([orderItemId])
}

model StockWithdrawal {
  id            String      @id @db.Uuid
  receiptItemId String      @db.Uuid
  receiptItem   ReceiptItem @relation(fields: [receiptItemId], references: [id])
  quantity      Decimal     @db.Decimal(12, 3)
  reason        String
  notes         String?
  createdAt     DateTime    @default(now())
}

model Payment {
  id           String          @id @db.Uuid
  orderId      String          @db.Uuid
  order        Order           @relation(fields: [orderId], references: [id])
  amount       Decimal         @db.Decimal(12, 2)
  method       String
  paidAt       DateTime
  notes        String?
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime        @default(now())
  accountEntry CustomerCredit?

  @@index([orderId])
}

model Delivery {
  id          String         @id @db.Uuid
  orderId     String         @db.Uuid
  order       Order          @relation(fields: [orderId], references: [id])
  deliveredAt DateTime
  createdAt   DateTime       @default(now())
  items       DeliveryItem[]

  @@index([orderId])
}

model DeliveryItem {
  id          String    @id @default(uuid()) @db.Uuid
  deliveryId  String    @db.Uuid
  delivery    Delivery  @relation(fields: [deliveryId], references: [id])
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3)
}

// Accounting. Supplier invoices and customer payments are read from purchases
// and orders; these tables hold everything else.
model FinanceCategory {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  kind      String // INCOME | EXPENSE
  // Set on categories the app relies on; they cannot be renamed away or removed.
  systemKey String?            @unique
  // False for money that moves without being profit: owner contributions,
  // profit distributions, loans.
  inResult  Boolean            @default(true)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  movements FinanceMovement[]
  recurring RecurringExpense[]

  @@unique([kind, name])
}

model FinanceMovement {
  id           String            @id @db.Uuid
  kind         String // INCOME | EXPENSE
  // PENDING: generated by a recurring expense and not yet paid.
  // SKIPPED: a generated period that did not apply.
  status       String            @default("PAID")
  date         DateTime
  amount       Decimal           @db.Decimal(12, 2)
  categoryId   String            @db.Uuid
  category     FinanceCategory   @relation(fields: [categoryId], references: [id])
  description  String
  method       String? // CASH | TRANSFER
  paidBy       String            @default("BUSINESS") // BUSINESS | ARIEL | MARIA
  // When an owner paid: REIMBURSE (the business owes it back) or CONTRIBUTE.
  personalMode String?
  reimbursedAt DateTime?
  // Owner of a contribution or a profit distribution.
  owner        String?
  groupId      String?           @db.Uuid
  roundId      String?           @db.Uuid
  round        Round?            @relation(fields: [roundId], references: [id])
  recurringId  String?           @db.Uuid
  recurring    RecurringExpense? @relation(fields: [recurringId], references: [id])
  periodKey    String?
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([recurringId, periodKey])
  @@index([date])
  @@index([roundId])
}

model RecurringExpense {
  id          String            @id @default(uuid()) @db.Uuid
  description String
  categoryId  String            @db.Uuid
  category    FinanceCategory   @relation(fields: [categoryId], references: [id])
  amount      Decimal           @db.Decimal(12, 2)
  frequency   String // WEEKLY | BIWEEKLY | MONTHLY
  // MONTHLY: day of month 1-28. WEEKLY and BIWEEKLY: weekday 0 (Sunday)-6.
  day         Int
  startsOn    DateTime
  active      Boolean           @default(true)
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  movements   FinanceMovement[]
}

// A customer's account: money held for them, to be used on encargos.
// DEPOSIT: an advance received (cash in). OVERPAY: an order's excess moved
// here. APPLY: used on an order through a CREDIT payment. REFUND: returned.
model CustomerCredit {
  id         String    @id @db.Uuid
  customerId String    @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id])
  kind       String
  amount     Decimal   @db.Decimal(12, 2)
  method     String?
  date       DateTime
  notes      String?
  orderId    String?   @db.Uuid
  order      Order?    @relation(fields: [orderId], references: [id])
  paymentId  String?   @unique @db.Uuid
  payment    Payment?  @relation(fields: [paymentId], references: [id])
  voidedAt   DateTime?
  voidReason String?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([orderId])
}

// Small texts the owners edit in the app, e.g. payment details.
model Setting {
  key       String   @id
  value     String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}
