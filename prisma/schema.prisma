generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phoneCountryCode String @default("+504")
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Supplier {
  purchases Purchase[]
  deliveryContactName String?
  deliveryContactPhone String?
  deliveryContactCountryCode String @default("+504")
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  region    String
  phoneCountryCode String @default("+504")
  phone     String?
  createdAt DateTime    @default(now())
  products  Product[]
  items     OrderItem[]
}

model Product {
  purchaseItems PurchaseItem[]
  costEffectiveAt DateTime?
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  unit              String      @default("lb")
  salePrice         Decimal     @db.Decimal(12, 2)
  estimatedCost     Decimal     @db.Decimal(12, 2)
  defaultSupplierId String      @db.Uuid
  defaultSupplier   Supplier    @relation(fields: [defaultSupplierId], references: [id])
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  items             OrderItem[]
}

enum RoundStatus {
  OPEN
  CLOSED
}

model Round {
  purchases Purchase[]
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  status    RoundStatus @default(OPEN)
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime    @default(now())
  orders    Order[]
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  roundId    String      @db.Uuid
  round      Round       @relation(fields: [roundId], references: [id])
  customerId String      @db.Uuid
  customer   Customer    @relation(fields: [customerId], references: [id])
  notes      String?
  version    Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]

  @@index([roundId])
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id])
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)
  unitPrice  Decimal  @db.Decimal(12, 2)
  estimatedUnitCost Decimal? @db.Decimal(12, 2)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  before     Json?
  after      Json
  createdAt  DateTime @default(now())

  @@index([entityId, createdAt])
}

model Purchase {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  round Round @relation(fields: [roundId], references: [id])
  supplierId String @db.Uuid
  supplier Supplier @relation(fields: [supplierId], references: [id])
  orderedAt DateTime
  createdAt DateTime @default(now())
  version Int @default(1)
  items PurchaseItem[]
  receipts Receipt[]
}
model PurchaseItem {
  id String @id @default(uuid()) @db.Uuid
  purchaseId String @db.Uuid
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  quotedUnitCost Decimal @db.Decimal(12,2)
  receiptItems ReceiptItem[]
  @@unique([purchaseId, productId])
}
model Receipt {
  id String @id @db.Uuid
  purchaseId String @db.Uuid
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  receivedAt DateTime
  invoice String
  notes String?
  globalDiscount Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(14,2)
  createdAt DateTime @default(now())
  items ReceiptItem[]
}
model ReceiptItem {
  id String @id @default(uuid()) @db.Uuid
  receiptId String @db.Uuid
  receipt Receipt @relation(fields: [receiptId], references: [id])
  purchaseItemId String @db.Uuid
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(12,2)
  unitDiscount Decimal @db.Decimal(12,2)
  allocatedDiscount Decimal @db.Decimal(12,2)
  netTotal Decimal @db.Decimal(14,2)
  effectiveUnitCost Decimal @db.Decimal(16,6)
  @@unique([receiptId, purchaseItemId])
}
